"use strict";
document.addEventListener("click", function(e) {
    var wall = document.querySelector(".wall");
    var spider = document.querySelector(".spider");
    if (!e.target.closest(".wall")) return;
    var maxWidth = wall.clientWidth - spider.clientWidth;
    var maxHeight = wall.clientHeight - spider.clientHeight;
    var x = e.offsetX - spider.clientWidth / 2;
    var y = e.offsetY - spider.clientHeight / 2;
    if (x < 0) x = 0;
    if (y < 0) y = 0;
    if (maxWidth < x) x = maxWidth;
    if (maxHeight < y) y = maxHeight;
    spider.style.left = x + "px";
    spider.style.top = y + "px";
});

